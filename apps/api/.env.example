# Database
DATABASE_URL=postgresql://fundlens:fundlens_dev@localhost:5432/fundlens

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-random-32-char-string

# Optional: set to true to enable TimescaleDB extension (requires timescaledb installed)
ENABLE_TIMESCALE=false

# Data ingestion (Phase 2)
MFAPI_BASE_URL=https://api.mfapi.in
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
AUTO_SYNC_MF_UNIVERSE=true
AUTO_SYNC_NAVS=true
AUTO_SYNC_METRICS=true
MFAPI_TIMEOUT_SECONDS=30
