{
  "expo": {
    "name": "FundLens",
    "slug": "fundlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F1B2D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fundlens.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1B2D"
      },
      "package": "com.fundlens.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
